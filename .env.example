# =============================================================================
# Routine — environment variables
# Copy to .env.local and fill in values from Supabase.
# =============================================================================

# --- App ---
PORT=3120
# Public origin, no trailing slash (canonical URLs, sitemap, robots, HSTS, auth).
# Local: http://localhost:3120
# Production: one canonical host — https://tasqin.com or https://www.tasqin.com
NEXT_PUBLIC_SITE_URL=http://localhost:3120

# --- Supabase ---
# Dashboard → Project Settings → API
# Use the project host only — not /rest/v1/
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# Server only — NEVER expose in browser or commit
# Dashboard → Project Settings → API → service_role (secret)
# JWT eyJ… or new sb_secret_… — not the anon / sb_publishable_ key.
# Do not wrap the value in quotes in Vercel.
# Required so production can read site_integrations (Google / Resend login buttons).
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Database password — for local migrations (npm run db:migrate)
# Dashboard → Project Settings → Database → Database password
# SUPABASE_DB_PASSWORD=your_database_password
# Pooler region (Dashboard → Database → Connection string), default eu-west-1
# SUPABASE_DB_REGION=eu-west-1
# Or full connection string:
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Google OAuth Client ID / Secret are NOT app env vars.
# Paste them in Admin → Integrācijas (not Supabase Auth → Providers → Google).

# Same Google OAuth client — extra redirect URIs (local + production):
# http://localhost:3120/auth/google-oauth/callback
# http://localhost:3120/auth/google-drive/callback
# https://tasqin.com/auth/google-oauth/callback
# https://tasqin.com/auth/google-drive/callback
# Gmail plugin uses /auth/google-oauth/callback (same as login).
# Enable Google Drive API on the Cloud project.
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# ONEDRIVE_CLIENT_ID=
# ONEDRIVE_CLIENT_SECRET=

# AES-256-GCM key for OAuth/Drive/OneDrive/Resend secrets at rest.
# Generate: openssl rand -base64 32
# Keep the same value in production as locally. A new random key on Vercel
# cannot decrypt existing enc:v1: rows (email login stays hidden).
# If unset, decrypt also tries SUPABASE_SERVICE_ROLE_KEY.
# INTEGRATION_SECRETS_KEY=

# Chrome extension CORS allowlist (production required). Comma-separated extension IDs.
# CHROME_EXTENSION_IDS=
# NEXT_PUBLIC_CHROME_EXTENSION_IDS=

# Optional Subresource Integrity for the Umami script (sha384-... or sha256-...).
# UMAMI_SCRIPT_INTEGRITY=
# NEXT_PUBLIC_UMAMI_SCRIPT_INTEGRITY=

# Google Search Console HTML tag verification (content= value only).
# Search Console → Settings → Ownership verification → HTML tag.
# GOOGLE_SITE_VERIFICATION=
