# =============================================================================
# Routine — environment variables
# Copy to .env.local and fill in values from Supabase.
# =============================================================================

# --- App ---
PORT=3120
NEXT_PUBLIC_SITE_URL=http://localhost:3120

# --- Supabase ---
# Dashboard → Project Settings → API
# Use the project host only — not /rest/v1/
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# Server only — NEVER expose in browser or commit
# Dashboard → Project Settings → API → service_role (secret)
# Required for emailing brand-new invitees; existing users get in-app team_invite notification
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Database password — for local migrations (npm run db:migrate)
# Dashboard → Project Settings → Database → Database password
# SUPABASE_DB_PASSWORD=your_database_password
# Pooler region (Dashboard → Database → Connection string), default eu-west-1
# SUPABASE_DB_REGION=eu-west-1
# Or full connection string:
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Google OAuth Client ID / Secret are NOT app env vars.
# Paste them in Supabase Dashboard → Authentication → Providers → Google.

# Google Drive (team file sync) — separate OAuth client or extra redirect URI:
# Authorized redirect URI: http://localhost:3120/auth/google-drive/callback
# Enable Google Drive API on the Cloud project.
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# ONEDRIVE_CLIENT_ID=
# ONEDRIVE_CLIENT_SECRET=

# AES-256-GCM key for OAuth/Drive/OneDrive/Resend secrets at rest.
# Generate: openssl rand -base64 32
# Keep stable — rotating without re-encrypting existing rows makes tokens unreadable.
# If unset, the app derives a key from SUPABASE_SERVICE_ROLE_KEY (dev only).
# INTEGRATION_SECRETS_KEY=

# Chrome extension CORS allowlist (production required). Comma-separated extension IDs.
# CHROME_EXTENSION_IDS=
# NEXT_PUBLIC_CHROME_EXTENSION_IDS=

# Optional Subresource Integrity for the Umami script (sha384-... or sha256-...).
# UMAMI_SCRIPT_INTEGRITY=
# NEXT_PUBLIC_UMAMI_SCRIPT_INTEGRITY=
